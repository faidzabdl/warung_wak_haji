# Environment variables untuk frontend Warung Wak Haji
# Copy file ini ke .env lalu isi nilainya:
#   cp frontend/.env.example frontend/.env

# URL backend API — saat development: http://localhost:8000
# Saat production di Render: https://warung-backend.onrender.com (sesuaikan)
VITE_API_URL=http://localhost:8000

# Supabase project URL — dari Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key — dari Dashboard → Settings → API → anon public
# Aman untuk frontend (tunduk pada Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
